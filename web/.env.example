# Public browser URL for the Rust API. This value is embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_MODE=anonymous

# Server-only authentication configuration.
AUTH_MODE=anonymous
# GITHUB_ID=your_github_oauth_app_client_id
# GITHUB_SECRET=use_at_least_32_characters
# NEXTAUTH_SECRET=use_at_least_32_characters
# NEXTAUTH_URL=http://localhost:3000
# JWT_SECRET=use_at_least_32_characters
