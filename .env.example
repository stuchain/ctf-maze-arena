DATABASE_URL=postgresql://ctf_maze:local-development-only@localhost:5432/ctf_maze
DB_MAX_CONNECTIONS=5
DB_CONNECT_ATTEMPTS=5
MAX_CONCURRENT_SOLVES=1
# Per GitHub identity or source IP; protects queued and running work.
MAX_ACTIVE_SOLVES_PER_ACTOR=2
# Realtime protocol bounds and sampling controls.
STREAM_HISTORY_CAPACITY=256
STREAM_CLIENT_CAPACITY=32
STREAM_SAMPLE_EVERY=2
STREAM_SNAPSHOT_EVERY=32
MAX_REPLAY_EVENTS=2048
STREAM_RETENTION_SECS=30
STREAM_HEARTBEAT_SECS=10
RUST_LOG=info
# Optional log format: pretty (default) or json
# LOG_FORMAT=pretty
# Backend port (default 8080)
PORT=8080
# Production: comma-separated CORS origin allowlist
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# Escape hatch for controlled staging only (release builds)
# CORS_PERMISSIVE=false
# Global rate limit defaults (per IP): keep dev generous, tighten in production as needed
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=40
# Stricter limits for expensive endpoints (POST /api/solve and /api/maze/generate)
RATE_LIMIT_EXPENSIVE_PER_SECOND=5
RATE_LIMIT_EXPENSIVE_BURST=10
# Proxy trust for rate limiting key extraction:
# false -> peer socket IP only (safe default)
# true  -> use forwarded headers (x-forwarded-for/x-real-ip/forwarded) via SmartIpKeyExtractor
#         only enable behind trusted proxies that overwrite/strip spoofed headers
TRUST_PROXY=false
# JWT used by the web token route and API middleware. Required for jwt and optional_jwt modes.
# JWT_SECRET=generate_at_least_32_random_characters
# Auth rollout mode: anonymous | jwt | optional_jwt. Non-anonymous modes require JWT_SECRET.
AUTH_MODE=anonymous

# Frontend settings belong in web/.env.local; copy web/.env.example there.
